<Window x:Class="RobloxScriptExecutor.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:RobloxScriptExecutor.UI.Controls"
        Title="Roblox Script Executor" Height="700" Width="1100"
        Background="#1E1E1E" Foreground="White"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <md:ColorZone Mode="PrimaryMid" Padding="16" md:Elevation.Shadow="Dp3">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="CodeBracket" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="Roblox Script Executor" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </md:ColorZone>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar (File Explorer) -->
            <Border Grid.Column="0" Background="#252526" CornerRadius="8" Margin="0,0,12,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="SCRIPT EXPLORER" FontWeight="Bold" Margin="0,0,0,12" Foreground="#AAAAAA"/>
                    <ListBox x:Name="FilesList"
                               ItemsSource="{Binding Explorer.Files}"
                               SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                               Background="Transparent" BorderThickness="0" Foreground="White">
                    </ListBox>
                    <Button Content="New Script" Command="{Binding Explorer.CreateFileCommand}"
                            Margin="0,12,0,0" HorizontalAlignment="Stretch" Style="{StaticResource MaterialDesignFlatButton}"/>
                </StackPanel>
            </Border>

            <!-- Editor Area -->
            <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="8" Padding="0">
                <Grid>
                    <controls:LuauEditor x:Name="CodeEditor" />

                    <!-- Floating Action Buttons -->
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="20">
                        <Button Content="Save" Command="{Binding Editor.SaveFileCommand}"
                                Style="{StaticResource MaterialDesignFloatingActionButton}"
                                ToolTip="Save current script" Margin="0,0,0,10"/>
                        <Button Content="Execute" Command="{Binding ExecuteCommand}"
                                Style="{StaticResource MaterialDesignFloatingActionButton}"
                                Background="LimeGreen" Foreground="Black"
                                ToolTip="Run script in Roblox Studio" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Console Area -->
        <Border Grid.Row="2" Background="#121212" Margin="16,0,16,16" CornerRadius="8" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="ConsoleLogs"
                         ItemsSource="{Binding Logs}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Timestamp}" Foreground="#666666" Margin="0,0,8,0" FontSize="11"/>
                                <TextBlock Text="{Binding Level}" Foreground="{Binding Foreground}" FontWeight="Bold" Margin="0,0,8,0" FontSize="11"/>
                                <TextBlock Text="{Binding Message}" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Column="1" Content="Clear" Command="{Binding ClearLogsCommand}"
                        VerticalAlignment="Top" Margin="12,0,0,0"
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="#AAAAAA"/>
            </Grid>
        </Border>

        <!-- Footer/Status Bar -->
        <Border Grid.Row="3" Background="#007ACC" Padding="8" md:Elevation.Shadow="Dp2">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Information" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StudioStatus}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,0,20,0"/>
                    <TextBlock Text="Version: " VerticalAlignment="Center" Foreground="#B0B0B0"/>
                    <TextBlock Text="{Binding StudioVersion}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,20,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <md:PackIcon Kind="Server" VerticalAlignment="Center"
                               Foreground="{Binding IsServerRunning, Converter={StaticResource BooleanToColorConverter}}"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding IsServerRunning, Converter={StaticResource BooleanToStatusConverter}}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
